# Dockerfile (in ./frontend)
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy dependency files and install
COPY package*.json ./
RUN npm install

# Copy rest of frontend code
COPY . .

# Expose Vite port 3000
EXPOSE 3000

# Start Vite dev server on port 3000, allow external access
CMD ["npm", "run", "dev", "--", "--port", "3000", "--host"]